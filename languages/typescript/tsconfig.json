{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["solutions/**/*.ts", "starters/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
